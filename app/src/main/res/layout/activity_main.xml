<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:layout_margin="0dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey"
        android:padding="20dp"
        android:text="@string/calc_kcal"
        android:textAlignment="center"
        android:textColor="@color/red"
        android:textSize="26sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/heightSeekBarText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textColor="@color/green"
        android:padding="20dp"
        android:textColorHint="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        tools:ignore="MissingConstraints" />

    <SeekBar
        android:id="@+id/seekBarHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="190"
        android:min="20"
        android:progress="0"
        android:progressDrawable="@drawable/slider_track"
        android:thumb="@drawable/slider_thumb"
        app:layout_constraintTop_toBottomOf="@+id/heightSeekBarText"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="69dp" />

    <TextView
        android:id="@+id/weightSeekBarText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textAlignment="center"
        android:textColor="@color/green"
        android:textSize="20sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@+id/seekBarHeight"
        tools:ignore="MissingConstraints" />

    <SeekBar
        android:id="@+id/seekBarWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="20"
        android:max="260"
        android:progress="4"
        android:progressDrawable="@drawable/slider_track"
        android:thumb="@drawable/slider_thumb"
        app:layout_constraintTop_toBottomOf="@+id/weightSeekBarText"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="46dp" />


    <TextView
        android:id="@+id/ageSeekBarText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textColor="@color/green"
        android:padding="20dp"
        android:textColorHint="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/seekBarWeight"
        tools:ignore="MissingConstraints" />

    <SeekBar
        android:id="@+id/seekBarAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="5"
        android:max="100"
        android:progress="5"
        android:progressDrawable="@drawable/slider_track"
        android:thumb="@drawable/slider_thumb"
        app:layout_constraintTop_toBottomOf="@+id/ageSeekBarText"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="46dp" />

    <TextView
        android:id="@+id/stepTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zero"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@+id/calculationButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/calculationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calculation"
        android:textSize="24sp"
        android:textStyle="italic"
        android:padding="20dp"
        android:layout_marginTop="30dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/green"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuTextFieldHuman"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enterHuman"
        android:textColorHint="@color/white"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/seekBarAge"
        tools:ignore="MissingConstraints">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTextViewHuman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:inputType="none" /> <!-- none забороняє ручне введення тексту -->
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuTextFieldLoad"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enterLoad"
        android:textColorHint="@color/white"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/menuTextFieldHuman"
        tools:ignore="MissingConstraints">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTextViewLoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:inputType="none" /> <!-- none забороняє ручне введення тексту -->
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuTextFieldGoal"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enterGoal"
        android:textColorHint="@color/white"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/menuTextFieldLoad"
        tools:ignore="MissingConstraints">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTextViewGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:inputType="none" /> <!-- none забороняє ручне введення тексту -->
    </com.google.android.material.textfield.TextInputLayout>



</androidx.constraintlayout.widget.ConstraintLayout>